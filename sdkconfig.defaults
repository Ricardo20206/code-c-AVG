# Ventec AGV — ESP32-PICO-D4 + PSRAM IS66WVS1M8BLL (schéma Ventec / ref. Espressif)
#
# Bus SPI partagé flash intégrée + PSRAM externe (quad) :
#   CLK  SD_CLK     GPIO6   (broche puce 31) → PSRAM pin 6
#   CS#  SD_DATA_3  GPIO10  (broche puce 29) → PSRAM pin 1 CE#
#   SIO0 SD_DATA_1  GPIO8   (broche puce 33) → PSRAM pin 5 SI
#   SIO1 GPIO17     GPIO17  (broche puce 27) → PSRAM pin 2 SO
#   SIO2 SD_DATA_0  GPIO7   (broche puce 32) → PSRAM pin 3 SIO2
#   SIO3 SD_CMD     GPIO11  (broche puce 30) → PSRAM pin 7 SIO3
#
# ATTENTION : CONFIG_SPIRAM_*_IO = numéro GPIO, pas numéro de broche du boîtier !

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_CLK_IO=6
CONFIG_SPIRAM_CS_IO=10
CONFIG_SPIRAM_MEMTEST=y
